@model EBookStore.Models.Page

@{
    ViewData["Title"] = "Edit Page";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4">
        <!-- Card header -->
        <div class="card-header text-white rounded-top-4" style="background: linear-gradient(90deg, #0d6efd, #6610f2);">
            <h4 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i> Edit Page</h4>
        </div>

        <!-- Card body -->
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" readonly asp-for="ID" />

                <!-- Product -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Product</label>
                    <select asp-for="ProductID" class="form-control rounded shadow-sm" asp-items="ViewBag.ProductID"></select>
                    <span asp-validation-for="ProductID" class="text-danger"></span>
                </div>

                <!-- Page Number -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Page Number</label>
                    <input asp-for="PageNumber" class="form-control rounded shadow-sm" />
                    <span asp-validation-for="PageNumber" class="text-danger"></span>
                </div>

                <!-- Status -->
                <div class="form-check mb-3">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="Status" /> @Html.DisplayNameFor(model => model.Status)
                    </label>
                </div>

                <input type="hidden" readonly asp-for="Image" value="abcdef" />

                <!-- Action buttons -->
                <div class="d-flex gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left-circle me-1"></i> Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-save2-fill me-1"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
