@{
    ViewData["Title"] = "ResetPassword";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int id = ViewBag.id;
}

<div class="container mt-5 d-flex justify-content-center">
    <div style="max-width: 420px; width: 100%;">
        <div class="card shadow-lg rounded-4">
            <div class="card-body p-4">
                <h4 class="card-title text-center mb-4 fw-bold">
                    <i class="bi bi-lock-fill me-2"></i> Reset Your Password
                </h4><br />
                <form asp-action="ResetPassword" asp-controller="User" method="post" novalidate>
                    <input type="hidden" asp-for="@id" /><br />
                    <div class="mb-4">
                        <label class="form-label fw-semibold">New Password</label>
                        <input type="password" name="password" id="password" class="form-control form-control-lg" placeholder="Enter new password" required autocomplete="new-password" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Confirm Password</label>
                        <input type="password" name="confirmPassword" id="confirmPassword" class="form-control form-control-lg" placeholder="Confirm new password" required autocomplete="new-password" />
                    </div>

                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-success btn-lg shadow-sm">
                            <i class="bi bi-check2-circle me-2"></i> Reset Password
                        </button>
                        <a class="btn btn-outline-secondary btn-lg shadow-sm text-center" asp-action="Index" asp-controller="User">
                            <i class="bi bi-x-circle me-2"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

