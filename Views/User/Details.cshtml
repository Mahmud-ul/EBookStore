@model EBookStore.Models.User

@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container">
    <div class="card shadow-sm border-0 rounded-4 p-3">
        <!-- Card header -->
        <div class="card-header bg-gradient-primary rounded-top mb-4">
            <h5 class="mb-0"><i class="bi bi-person-fill me-2"></i> User Details</h5>
        </div>

        <!-- Card body -->
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Name</dt>
                <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.Name)</dd>

                <dt class="col-sm-3 text-muted">Email</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

                <dt class="col-sm-3 text-muted">Phone</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Phone)</dd>

                <dt class="col-sm-3 text-muted">Status</dt>
                <dd class="col-sm-9 mb-0">
                    <span class="badge @(Model.Status ? "bg-success" : "bg-danger")">
                        @(Model.Status ? "Active" : "Inactive")
                    </span>
                </dd>

                <dt class="col-sm-3 text-muted">User Type</dt>
                <dd class="col-sm-9">@(Model.UserType?.Name ?? "N/A")</dd>
            </dl>

            <!-- Action buttons below -->
            <div class="mt-5 d-flex gap-3">
                <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-warning">
                    <i class="fa fa-edit me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .card-header {
        font-weight: 600;
    }

    .badge {
        font-size: 0.9rem;
        padding: 0.5rem 0.75rem;
    }
</style>
