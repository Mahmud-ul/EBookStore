@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid my-1">

    <!-- Welcome Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-speedometer2 me-2"></i> Dashboard</h2>
        <span class="text-muted fs-6">Welcome back, Admin!</span>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">

        <!-- Total Authors -->
        <div class="col-md-3">
            <div class="card text-white shadow-lg rounded-4" style="background: linear-gradient(135deg,#6f42c1,#6610f2);">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title">Authors</h5>
                        <h3 class="fw-bold">@ViewBag.TotalAuthors</h3>
                    </div>
                    <i class="bi bi-pen-fill fs-2 opacity-75"></i>
                </div>
            </div>
        </div>

        <!-- Total Users -->
        <div class="col-md-3">
            <div class="card text-white shadow-lg rounded-4" style="background: linear-gradient(135deg,#20c997,#0dcaf0);">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title">Users</h5>
                        <h3 class="fw-bold">@ViewBag.TotalUsers</h3>
                    </div>
                    <i class="bi bi-people-fill fs-2 opacity-75"></i>
                </div>
            </div>
        </div>

        <!-- Total Products -->
        <div class="col-md-3">
            <div class="card text-white shadow-lg rounded-4" style="background: linear-gradient(135deg,#fd7e14,#ffc107);">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title">Products</h5>
                        <h3 class="fw-bold">@ViewBag.TotalProducts</h3>
                    </div>
                    <i class="bi bi-box-seam fs-2 opacity-75"></i>
                </div>
            </div>
        </div>

        <!-- Total Orders -->
        <div class="col-md-3">
            <div class="card text-white shadow-lg rounded-4" style="background: linear-gradient(135deg,#dc3545,#ff6b6b);">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="card-title">Orders</h5>
                        <h3 class="fw-bold">@ViewBag.TotalOrders</h3>
                    </div>
                    <i class="bi bi-bag-fill fs-2 opacity-75"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">

        <!-- Orders Status Chart -->
        <div class="col-lg-6">
            <div class="card shadow-lg rounded-4">
                <div class="card-header bg-dark text-white d-flex align-items-center">
                    <i class="bi bi-graph-up me-2"></i> Orders Status
                </div>
                <div class="card-body">
                    <canvas id="ordersStatusChart" height="250"></canvas>
                </div>
            </div>
        </div>

        <!-- Products & Users Trend -->
        <div class="col-lg-6">
            <div class="card shadow-lg rounded-4">
                <div class="card-header bg-dark text-white d-flex align-items-center">
                    <i class="bi bi-bar-chart-line me-2"></i> Products & Users Trend
                </div>
                <div class="card-body">
                    <canvas id="productsUsersChart" height="250"></canvas>
                </div>
            </div>
        </div>

    </div>

    <!-- Quick Actions Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <a href="@Url.Action("Create", "Author")" class="btn btn-primary w-100 rounded-pill shadow-lg py-3">
                <i class="bi bi-plus-circle me-2"></i> Add Author
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Create", "Product")" class="btn btn-warning w-100 rounded-pill shadow-lg py-3 text-white">
                <i class="bi bi-plus-circle me-2"></i> Add Product
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Create", "User")" class="btn btn-success w-100 rounded-pill shadow-lg py-3">
                <i class="bi bi-plus-circle me-2"></i> Add User
            </a>
        </div>
        <div class="col-md-3">
            <a href="@Url.Action("Create", "Order")" class="btn btn-danger w-100 rounded-pill shadow-lg py-3">
                <i class="bi bi-plus-circle me-2"></i> Add Order
            </a>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Orders Status Pie Chart
        const ordersStatusCtx = document.getElementById('ordersStatusChart').getContext('2d');
        new Chart(ordersStatusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Pending', 'On Process', 'Delivered', 'Canceled'],
                datasets: [{
                    label: 'Orders Status',
                    data: @Html.Raw(Json.Serialize(ViewBag.OrdersStatusData)),
                    backgroundColor: ['#ffc107', '#0dcaf0', '#198754', '#dc3545'],
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // Products & Users Trend Line Chart
        const productsUsersCtx = document.getElementById('productsUsersChart').getContext('2d');
        new Chart(productsUsersCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.Months)),
                datasets: [
                    {
                        label: 'Products',
                        data: @Html.Raw(Json.Serialize(ViewBag.ProductsTrend)),
                        borderColor: '#ffc107',
                        fill: false,
                        tension: 0.4
                    },
                    {
                        label: 'Users',
                        data: @Html.Raw(Json.Serialize(ViewBag.UsersTrend)),
                        borderColor: '#0dcaf0',
                        fill: false,
                        tension: 0.4
                    }
                ]
            },
            options: { responsive: true }
        });
    </script>
}
