@model EBookStore.Models.CreateModel.LoginUserModel
@{
    ViewData["Title"] = "ForgotPassword";
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger text-center shadow-sm rounded-3 mt-3">
        <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Error
    </div>
}

<div class="container mt-5 d-flex justify-content-center">
    <div style="max-width: 420px; width: 100%;">
        <div class="card shadow-lg rounded-4">
            <div class="card-body p-4">
                <h4 class="card-title text-center mb-4 fw-bold">
                    <i class="bi bi-key-fill me-2"></i> Forgot Password
                </h4>

                <form asp-action="ForgotPassword" asp-controller="Account" method="post" novalidate>
                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                        <input asp-for="Email" class="form-control form-control-lg" required placeholder="Enter your email" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-3">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                            <i class="bi bi-envelope-fill me-2"></i> Send Verification Code
                        </button>
                        <a class="btn btn-outline-secondary btn-lg shadow-sm text-center" asp-action="Login" asp-controller="Account">
                            Back to Login
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

