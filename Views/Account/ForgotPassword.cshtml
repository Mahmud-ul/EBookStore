@model EBookStore.Models.CreateModel.LoginUserModel
@{
    ViewData["Title"] = "ForgotPassword";
    Layout = null; // keep null to apply full-page custom background styling
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Forgot Password</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: url('@Url.Content("~/Image/loginBG.jpg")') no-repeat center center fixed;
            background-size: cover;
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .forgot-container {
            max-width: 420px;
            width: 90%;
            background-color: rgba(255, 255, 255, 0.5);
            border-radius: 15px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            padding: 40px 30px;
            backdrop-filter: blur(5px);
        }

            .forgot-container h4 {
                text-align: center;
                font-weight: 700;
                margin-bottom: 30px;
                color: #333;
            }

        .form-label {
            color: #333;
            font-weight: 600;
        }

        .form-control {
            border-radius: 10px;
            background-color: #ffffffcc;
        }

        .btn-primary {
            background: linear-gradient(45deg, #0d6efd, #6610f2);
            border: none;
            font-weight: 600;
            border-radius: 30px;
            transition: all 0.3s ease-in-out;
        }

            .btn-primary:hover {
                transform: scale(1.03);
                box-shadow: 0 6px 16px rgba(13, 110, 253, 0.4);
            }

        .btn-outline-secondary {
            border-radius: 30px;
            transition: all 0.3s ease-in-out;
        }

            .btn-outline-secondary:hover {
                transform: scale(1.03);
            }

        .alert-danger {
            background-color: rgba(220, 53, 69, 0.9);
            border: none;
            color: #fff;
        }
    </style>
</head>

<body>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center shadow-sm rounded-3 mb-3">
            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Error
        </div>
    }

    <div class="forgot-container">
        <h4>
            <i class="bi bi-key-fill me-2"></i> Forgot Password
        </h4>

        <form asp-action="ForgotPassword" asp-controller="Account" method="post" novalidate>
            <div class="mb-4">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control form-control-lg" required placeholder="Enter your email" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="d-grid gap-3">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-envelope-fill me-2"></i> Send Verification Code
                </button>
                <a class="btn btn-outline-secondary btn-lg text-center" asp-action="Login" asp-controller="Account">
                    Back to Login
                </a>
            </div>
        </form>
    </div>
</body>
</html>
