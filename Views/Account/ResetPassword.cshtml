@{
    ViewData["Title"] = "ResetPassword";
    Layout = null; // full-page background like login page
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Reset Password</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: url('@Url.Content("~/Image/loginBG.jpg")') no-repeat center center fixed;
            background-size: cover;
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .reset-container {
            max-width: 420px;
            width: 90%;
            background-color: rgba(255, 255, 255, 0.5);
            border-radius: 15px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            padding: 40px 30px;
            backdrop-filter: blur(5px);
        }

            .reset-container h4 {
                text-align: center;
                font-weight: 700;
                margin-bottom: 30px;
                color: #333;
            }

        .form-label {
            color: #333;
            font-weight: 600;
        }

        .form-control {
            border-radius: 10px;
            background-color: #ffffffcc;
        }

        .btn-success {
            background: linear-gradient(45deg, #198754, #20c997);
            border: none;
            font-weight: 600;
            border-radius: 30px;
            transition: all 0.3s ease-in-out;
        }

            .btn-success:hover {
                transform: scale(1.03);
                box-shadow: 0 6px 16px rgba(25, 135, 84, 0.4);
            }

        .btn-outline-secondary {
            border-radius: 30px;
            transition: all 0.3s ease-in-out;
        }

            .btn-outline-secondary:hover {
                transform: scale(1.03);
            }

        .alert-danger {
            background-color: rgba(220, 53, 69, 0.9);
            border: none;
            color: #fff;
        }
    </style>
</head>

<body>
    <div class="reset-container">
        <h4>
            <i class="bi bi-lock-fill me-2"></i> Reset Your Password
        </h4>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
            </div>
        }

        <form asp-action="ResetPassword" asp-controller="Account" method="post" novalidate>
            <div class="mb-4">
                <label for="code" class="form-label">Verification Code</label>
                <input type="text" name="code" id="code" class="form-control form-control-lg" placeholder="Enter the code you received" required autocomplete="one-time-code" />
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">New Password</label>
                <input type="password" name="password" id="password" class="form-control form-control-lg" placeholder="Enter new password" required autocomplete="new-password" />
            </div>

            <div class="mb-4">
                <label for="confirmPassword" class="form-label">Confirm Password</label>
                <input type="password" name="confirmPassword" id="confirmPassword" class="form-control form-control-lg" placeholder="Confirm new password" required autocomplete="new-password" />
            </div>

            <div class="d-grid gap-3">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="bi bi-check2-circle me-2"></i> Reset Password
                </button>
                <a class="btn btn-outline-secondary btn-lg text-center" asp-action="Index" asp-controller="Account">
                    <i class="bi bi-x-circle me-2"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</body>
</html>
