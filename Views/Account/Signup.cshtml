@model EBookStore.Models.User
@{
    ViewData["Title"] = "Signup";
}

<section id="signup-section" class="py-5 my-5" style="background: linear-gradient(135deg, #f8f9fb, #eef1f6);">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-lg-6 col-md-8">

                <!-- Header Section -->
                <div class="text-center mb-5" data-aos="fade-up">
                    <h2 class="fw-bold display-6 mb-2 text-dark">
                        Create Your <span class="text-primary">Account</span>
                    </h2>
                    <p class="text-muted mb-0">Join our reading family and enjoy exclusive offers on your favorite books.</p>
                </div>

                <!-- Signup Card -->
                <div class="card border-0 shadow-lg rounded-4 p-5 bg-white" data-aos="fade-up" data-aos-delay="100">
                    <form asp-action="Signup" asp-controller="Account" method="post" class="needs-validation" novalidate>
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold">Full Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 rounded-start-pill">
                                    <i class="bi bi-person-fill text-secondary"></i>
                                </span>
                                <input asp-for="Name" class="form-control rounded-end-pill shadow-sm" placeholder="Enter your full name" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 rounded-start-pill">
                                    <i class="bi bi-envelope-fill text-secondary"></i>
                                </span>
                                <input asp-for="Email" class="form-control rounded-end-pill shadow-sm" placeholder="Enter your email address" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Phone" class="form-label fw-semibold">Phone Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 rounded-start-pill">
                                    <i class="bi bi-telephone-fill text-secondary"></i>
                                </span>
                                <input asp-for="Phone" class="form-control rounded-end-pill shadow-sm" placeholder="Enter your phone number" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 rounded-start-pill">
                                    <i class="bi bi-lock-fill text-secondary"></i>
                                </span>
                                <input asp-for="Password" type="password" class="form-control rounded-end-pill shadow-sm" placeholder="Create a password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0 rounded-start-pill">
                                    <i class="bi bi-shield-lock-fill text-secondary"></i>
                                </span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control rounded-end-pill shadow-sm" placeholder="Confirm your password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mb-4">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-semibold shadow-sm">
                                <i class="bi bi-person-plus-fill me-2"></i> Sign Up
                            </button>
                        </div>

                        <div class="text-center">
                            <span class="text-muted">Already have an account?</span>
                            <a asp-action="Login" asp-controller="Account" class="fw-semibold text-primary text-decoration-none ms-1">
                                Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
