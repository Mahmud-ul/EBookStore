@model EBookStore.Models.Product

@{
    ViewData["Title"] = "Delete Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4">
        <!-- Card header -->
        <div class="card-header text-white rounded-top-4" style="background: linear-gradient(90deg, #dc3545, #b02a37);">
            <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Product</h4>
        </div>

        <!-- Card body -->
        <div class="card-body p-4">
            <h5 class="mb-4">Are you sure you want to delete this product?</h5>

            <dl class="row mb-4">
                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Name)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Category)</dt>
                <dd class="col-sm-9">@(Model.Category != null ? Model.Category.Name : "N/A")</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Author)</dt>
                <dd class="col-sm-9">@(Model.Author != null ? Model.Author.Name : "N/A")</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Publisher)</dt>
                <dd class="col-sm-9">@(Model.Publisher != null ? Model.Publisher.Name : "N/A")</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Cover)</dt>
                <dd class="col-sm-9">@(Model.Cover != null ? Model.Cover.Name : "N/A")</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Price)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Price)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Discount)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Discount)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.PageQuantity)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.PageQuantity)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Topic)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Topic)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Description)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Featured)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Featured)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Popular)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Popular)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.New)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.New)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.PreOrderable)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.PreOrderable)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.InStock)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.InStock)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.BestSeller)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.BestSeller)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.SlideShow)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.SlideShow)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Status)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Status)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Image)</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image" class="img-fluid" style="max-height:100px;" alt="Product Image" />
                    }
                    else
                    {
                        <img src="~/Images/NoImage.jpg" class="img-fluid" style="max-height:100px;" alt="No Image" />
                    }
                </dd>
            </dl>

            <form asp-action="Delete" class="d-flex gap-3">
                <input type="hidden" asp-for="ID" />
                <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                    <i class="bi bi-trash-fill me-1"></i> Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left-circle me-1"></i> Back
                </a>
            </form>
        </div>
    </div>
</div>
