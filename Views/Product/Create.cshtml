@model EBookStore.Models.CreateModel.ProductCreateModel
@{
    ViewData["Title"] = "Create Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4">
        <!-- Card header -->
        <div class="card-header text-white rounded-top-4" style="background: linear-gradient(90deg, #0d6efd, #6610f2);">
            <h4 class="mb-0">
                <i class="bi bi-box-seam me-2"></i> Create Product
            </h4>
        </div>

        <!-- Card body -->
        <div class="card-body p-4">
            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Text Inputs -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control rounded shadow-sm" placeholder="Enter product name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Category</label>
                        <select asp-for="CategoryID" class="form-control rounded shadow-sm" asp-items="ViewBag.CategoryID">
                            <option value="0">--Select Category--</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Author</label>
                        <select asp-for="AuthorID" class="form-control rounded shadow-sm" asp-items="ViewBag.AuthorID">
                            <option value="0">--Select Author--</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Publisher</label>
                        <select asp-for="PublisherID" class="form-control rounded shadow-sm" asp-items="ViewBag.PublisherID">
                            <option value="0">--Select Publisher--</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Cover</label>
                        <select asp-for="CoverID" class="form-control rounded shadow-sm" asp-items="ViewBag.CoverID">
                            <option value="0">--Select Cover--</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label fw-semibold"></label>
                        <input asp-for="Price" class="form-control rounded shadow-sm" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Discount" class="form-label fw-semibold"></label>
                        <input asp-for="Discount" class="form-control rounded shadow-sm" />
                        <span asp-validation-for="Discount" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Page Quantity</label>
                        <input asp-for="PageQuantity" class="form-control rounded shadow-sm" />
                        <span asp-validation-for="PageQuantity" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Topic" class="form-label fw-semibold"></label>
                    <input asp-for="Topic" class="form-control rounded shadow-sm" />
                    <span asp-validation-for="Topic" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control rounded shadow-sm"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Checkboxes -->
                <div class="row row-cols-2 row-cols-md-4 g-3 mb-3">
                    <div class="col">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Featured" id="featuredCheck" />
                            <label class="form-check-label" for="featuredCheck">@Html.DisplayNameFor(m => m.Featured)</label>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Popular" id="popularCheck" />
                            <label class="form-check-label" for="popularCheck">@Html.DisplayNameFor(m => m.Popular)</label>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="New" id="newCheck" />
                            <label class="form-check-label" for="newCheck">@Html.DisplayNameFor(m => m.New)</label>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="PreOrderable" id="preOrderCheck" />
                            <label class="form-check-label" for="preOrderCheck">@Html.DisplayNameFor(m => m.PreOrderable)</label>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="InStock" id="inStockCheck" />
                            <label class="form-check-label" for="inStockCheck">@Html.DisplayNameFor(m => m.InStock)</label>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="BestSeller" id="bestSellerCheck" />
                            <label class="form-check-label" for="bestSellerCheck">@Html.DisplayNameFor(m => m.BestSeller)</label>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="SlideShow" id="slideShowCheck" />
                            <label class="form-check-label" for="slideShowCheck">@Html.DisplayNameFor(m => m.SlideShow)</label>
                        </div>
                    </div>
                    <div class="col">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Status" id="statusCheck" />
                            <label class="form-check-label" for="statusCheck">@Html.DisplayNameFor(m => m.Status)</label>
                        </div>
                    </div>
                </div>

                <!-- Image upload -->
                <div class="mb-3 row">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold"><i>Choose an image:</i></label>
                        <input type="file" asp-for="Image" id="selectedImage" accept="image/*" class="form-control rounded" />
                    </div>
                    <div class="col-md-6" id="preview"></div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left-circle me-1"></i> Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-save2-fill me-1"></i> Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @@await Html.RenderPartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            $("#selectedImage").change(function (event) {
                var input = event.target;
                if (input.files && input.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $("#preview").html('<img src="' + e.target.result + '" class="img-fluid rounded" style="max-height:100px;" />');
                    }
                    reader.readAsDataURL(input.files[0]);
                } else {
                    $("#preview").html('');
                }
            });
        });
    </script>
}
