@model EBookStore.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4">
        <!-- Card header -->
        <div class="card-header text-white rounded-top-4" style="background: linear-gradient(90deg, #0d6efd, #6610f2);">
            <h4 class="mb-0"><i class="bi bi-book me-2"></i> Edit Product</h4>
        </div>

        <!-- Card body -->
        <div class="card-body p-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="ID" />

                <!-- Product Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control rounded shadow-sm" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Category, Author, Publisher, Cover -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Category</label>
                    <select asp-for="CategoryID" class="form-control rounded shadow-sm" asp-items="ViewBag.CategoryID">
                        <option value="0">--Select Category--</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Author</label>
                    <select asp-for="AuthorID" class="form-control rounded shadow-sm" asp-items="ViewBag.AuthorID">
                        <option value="0">--Select Author--</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Publisher</label>
                    <select asp-for="PublisherID" class="form-control rounded shadow-sm" asp-items="ViewBag.PublisherID">
                        <option value="0">--Select Publisher--</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Cover</label>
                    <select asp-for="CoverID" class="form-control rounded shadow-sm" asp-items="ViewBag.CoverID">
                        <option value="0">--Select Cover--</option>
                    </select>
                </div>

                <!-- Price & Discount -->
                <div class="mb-3">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <input asp-for="Price" class="form-control rounded shadow-sm" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Discount" class="form-label fw-semibold"></label>
                    <input asp-for="Discount" class="form-control rounded shadow-sm" />
                    <span asp-validation-for="Discount" class="text-danger"></span>
                </div>

                <!-- Other Details -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Page Quantity</label>
                    <input asp-for="PageQuantity" class="form-control rounded shadow-sm" />
                    <span asp-validation-for="PageQuantity" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Topic" class="form-label fw-semibold"></label>
                    <input asp-for="Topic" class="form-control rounded shadow-sm" />
                    <span asp-validation-for="Topic" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control rounded shadow-sm"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Checkboxes -->
                <div class="form-check mb-2">
                    <input class="form-check-input" asp-for="Featured" />
                    <label class="form-check-label">@Html.DisplayNameFor(model => model.Featured)</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" asp-for="Popular" />
                    <label class="form-check-label">@Html.DisplayNameFor(model => model.Popular)</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" asp-for="New" />
                    <label class="form-check-label">@Html.DisplayNameFor(model => model.New)</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" asp-for="PreOrderable" />
                    <label class="form-check-label">@Html.DisplayNameFor(model => model.PreOrderable)</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" asp-for="InStock" />
                    <label class="form-check-label">@Html.DisplayNameFor(model => model.InStock)</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" asp-for="BestSeller" />
                    <label class="form-check-label">@Html.DisplayNameFor(model => model.BestSeller)</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" asp-for="SlideShow" />
                    <label class="form-check-label">@Html.DisplayNameFor(model => model.SlideShow)</label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Status" />
                    <label class="form-check-label">@Html.DisplayNameFor(model => model.Status)</label>
                </div>

                <!-- Action buttons -->
                <div class="d-flex gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left-circle me-1"></i> Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-save2-fill me-1"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
