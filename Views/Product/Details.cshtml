@model EBookStore.Models.Product

@{
    ViewData["Title"] = "Product Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container">
    <div class="card shadow-sm border-0 rounded-4 p-3">
        <!-- Card header -->
        <div class="card-header bg-gradient-primary rounded-top mb-4">
            <h5 class="mb-0"><i class="bi bi-book me-2"></i> Product Details</h5>
        </div>

        <!-- Card body -->
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Name</dt>
                <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.Name)</dd>

                <dt class="col-sm-3 text-muted">Category</dt>
                <dd class="col-sm-9">@(Model.Category?.Name ?? "N/A")</dd>

                <dt class="col-sm-3 text-muted">Author</dt>
                <dd class="col-sm-9">@(Model.Author?.Name ?? "N/A")</dd>

                <dt class="col-sm-3 text-muted">Publisher</dt>
                <dd class="col-sm-9">@(Model.Publisher?.Name ?? "N/A")</dd>

                <dt class="col-sm-3 text-muted">Cover</dt>
                <dd class="col-sm-9">@(Model.Cover?.Name ?? "N/A")</dd>

                <dt class="col-sm-3 text-muted">Price</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Price)</dd>

                <dt class="col-sm-3 text-muted">Discount</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Discount)</dd>

                <dt class="col-sm-3 text-muted">Page Quantity</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.PageQuantity)</dd>

                <dt class="col-sm-3 text-muted">Topic</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Topic)</dd>

                <dt class="col-sm-3 text-muted">Description</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Description)</dd>

                <dt class="col-sm-3 text-muted">Featured</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Featured ? "bg-success" : "bg-danger")">
                        @(Model.Featured ? "Yes" : "No")
                    </span>
                </dd>
                <dt class="col-sm-3 text-muted">Popular</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Popular ? "bg-success" : "bg-danger")">
                        @(Model.Popular ? "Yes" : "No")
                    </span>
                </dd>
                <dt class="col-sm-3 text-muted">New</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.New ? "bg-success" : "bg-danger")">
                        @(Model.New ? "Yes" : "No")
                    </span>
                </dd>
                <dt class="col-sm-3 text-muted">PreOrderable</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.PreOrderable ? "bg-success" : "bg-danger")">
                        @(Model.PreOrderable ? "Yes" : "No")
                    </span>
                </dd>
                <dt class="col-sm-3 text-muted">In Stock</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.InStock ? "bg-success" : "bg-danger")">
                        @(Model.InStock ? "Yes" : "No")
                    </span>
                </dd>
                <dt class="col-sm-3 text-muted">Best Seller</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.BestSeller ? "bg-success" : "bg-danger")">
                        @(Model.BestSeller ? "Yes" : "No")
                    </span>
                </dd>
                <dt class="col-sm-3 text-muted">Slide Show</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.SlideShow ? "bg-success" : "bg-danger")">
                        @(Model.SlideShow ? "Yes" : "No")
                    </span>
                </dd>
                <dt class="col-sm-3 text-muted">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Status ? "bg-success" : "bg-danger")">
                        @(Model.Status ? "Active" : "Inactive")
                    </span>
                </dd>

                <dt class="col-sm-3 text-muted">Image</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image" class="img-fluid" style="max-height:120px;" alt="Product Image" />
                    }
                    else
                    {
                        <img src="\Images\NoImage.jpg" class="img-fluid" style="max-height:120px;" alt="No Image" />
                    }
                </dd>
            </dl>

            <!-- Action buttons below -->
            <div class="mt-5 d-flex gap-3">
                <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-warning">
                    <i class="fa fa-edit me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .card-header {
        font-weight: 600;
    }

    .badge {
        font-size: 0.9rem;
        padding: 0.5rem 0.75rem;
    }
</style>
