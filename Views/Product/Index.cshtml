@model IEnumerable<EBookStore.Models.Product>

@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container">
    <!-- Page title and Create button -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start mb-3">
        <h3 class="fw-bold mb-2 mb-md-0"><i class="bi bi-book-half me-2"></i> Products</h3>
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Create New
        </a>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient-secondary rounded-top">
            <small>All Products (Total: @(Model?.Count() ?? 0))</small>
        </div>

        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table id="example" class="table table-hover table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Image</th>
                                <th>Category</th>
                                <th>Author</th>
                                <th>Publisher</th>
                                <th>Cover</th>
                                <th>Price</th>
                                <th>Discount</th>
                                <th>Pages</th>
                                <th>Topic</th>
                                <th>Description</th>
                                <th>Featured</th>
                                <th>Popular</th>
                                <th>New</th>
                                <th>PreOrderable</th>
                                <th>InStock</th>
                                <th>BestSeller</th>
                                <th>SlideShow</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>
                                        <img src="@(item.Image ?? "/Images/NoImage.jpg")"
                                             class="img-fluid rounded" style="max-height:80px;"
                                             alt="Product Image" />
                                    </td>
                                    <td>@(item.Category?.Name ?? "N/A")</td>
                                    <td>@(item.Author?.Name ?? "N/A")</td>
                                    <td>@(item.Publisher?.Name ?? "N/A")</td>
                                    <td>@(item.Cover?.Name ?? "N/A")</td>
                                    <td>@item.Price</td>
                                    <td>@item.Discount</td>
                                    <td>@item.PageQuantity</td>
                                    <td>@item.Topic</td>
                                    <td>@item.Description</td>
                                    <td>
                                        <span class="badge @(item.Featured ? "bg-success" : "bg-danger")">
                                            @(item.Featured ? "Yes" : "No")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.Popular ? "bg-success" : "bg-danger")">
                                            @(item.Popular ? "Yes" : "No")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.New ? "bg-success" : "bg-danger")">
                                            @(item.New ? "Yes" : "No")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.PreOrderable ? "bg-success" : "bg-danger")">
                                            @(item.PreOrderable ? "Yes" : "No")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.InStock ? "bg-success" : "bg-danger")">
                                            @(item.InStock ? "Yes" : "No")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.BestSeller ? "bg-success" : "bg-danger")">
                                            @(item.BestSeller ? "Yes" : "No")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.SlideShow ? "bg-success" : "bg-danger")">
                                            @(item.SlideShow ? "Yes" : "No")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(item.Status ? "bg-success" : "bg-danger")">
                                            @(item.Status ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info text-white" title="Details">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning text-white" title="Edit">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            <a asp-action="EditImage" asp-route-id="@item.ID" class="btn btn-sm btn-primary text-white" title="Update Image">
                                                <i class="bi bi-image-fill"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this product?');">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-book-half text-muted display-4 mb-3"></i>
                    <h5 class="text-muted">No Products Found</h5>
                    <p class="mb-3">Start by creating your first product</p>
                    <a asp-action="Create" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-lg me-2"></i> Create New Product
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 8px;
    }

    .card-header {
        border-bottom: 1px solid #e9ecef;
    }

    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transition: 0.2s;
    }

    .badge {
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.35rem 0.5rem;
    }

    .btn-group .btn {
        padding: 0.35rem 0.65rem;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#example').DataTable({
                "order": [[0, "asc"]],
                "pageLength": 25,
                "scrollX": true,
                "language": {
                    "search": "Search Products:",
                    "lengthMenu": "Show _MENU_ products per page",
                    "info": "Showing _START_ to _END_ of _TOTAL_ products",
                    "infoEmpty": "No products available",
                    "infoFiltered": "(filtered from _MAX_ total)"
                },
                "columnDefs": [
                    { "orderable": false, "targets": [1, 19] }
                ]
            });
        });
    </script>
}
