@section Scripts {
    <script>
        $(document).ready(function () {
            // Quantity Controls
            $('#increaseQty').click(function () {
                var qty = parseInt($('#quantity').val());
                if (qty < 99) {
                    $('#quantity').val(qty + 1);
                }
            });

            $('#decreaseQty').click(function () {
                var qty = parseInt($('#quantity').val());
                if (qty > 1) {
                    $('#quantity').val(qty - 1);
                }
            });

            // Prevent manual input
            $('#quantity').on('keydown', function(e) {
                e.preventDefault();
            });

            // Add to Cart with AJAX
            $('#addToCartBtn').click(function () {
                var productId = $(this).data('product-id');
                var quantity = parseInt($('#quantity').val());

                $.ajax({
                    url: '@Url.Action("AddToCart", "Product")',
                    type: "POST",
                    data: { 
                        id: productId,
                        quantity: quantity 
                    },
                    beforeSend: function() {
                        $('#addToCartBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Adding...');
                    },
                    success: function (response) {
                        if (response.success) {
                            // Success feedback
                            $('#addToCartBtn').html('<i class="bi bi-check-circle-fill"></i> Added to Cart!');
                            
                            // Update cart display
                            $("#cart").text("Cart: (BDT " + response.totalCart + ")");
                            
                            // Reset button after 2 seconds
                            setTimeout(function() {
                                $('#addToCartBtn').prop('disabled', false).html('<i class="bi bi-cart-plus-fill"></i><span>ADD TO CART</span>');
                            }, 2000);
                        } else {
                            alert(response.message);
                            $('#addToCartBtn').prop('disabled', false).html('<i class="bi bi-cart-plus-fill"></i><span>ADD TO CART</span>');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error:", error);
                        alert("Failed to add book to cart. Please try again.");
                        $('#addToCartBtn').prop('disabled', false).html('<i class="bi bi-cart-plus-fill"></i><span>ADD TO CART</span>');
                    }
                });
            });

            // Preview Page Thumbnails - Click to view full page
            $('.preview-page-thumb').click(function() {
                var imageUrl = $(this).data('image');
                var pageNum = $(this).data('page');
                
                $('#modalPageImage').attr('src', imageUrl);
                $('#pageModalLabel').text('Page ' + pageNum);
                
                var pageModal = new bootstrap.Modal(document.getElementById('pageModal'));
                pageModal.show();
            });
        });
    </script>
}