@model IEnumerable<EBookStore.Models.Author>

@{
    ViewData["Title"] = "Authors";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container">
    <!-- Page title and Create button -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start mb-3">
        <h3 class="fw-bold mb-2 mb-md-0"><i class="bi bi-person-badge-fill me-2"></i> Author Management</h3>
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Create New Author
        </a>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <!-- Optional card header -->
        <div class="card-header bg-gradient-secondary rounded-top">
            <small>All registered authors (Total: @(Model?.Count() ?? 0))</small>
        </div>

        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle" id="example">
                        <thead class="table-light">
                            <tr>
                                <th style="width:5%">#</th>
                                <th style="width:50%">Author</th>
                                <th style="width:20%" class="text-center">Status</th>
                                <th style="width:25%" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowNumber = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-muted">@rowNumber</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle bg-primary text-white me-3">
                                                @item.Name?.Substring(0, 1).ToUpper()
                                            </div>
                                            <div>
                                                <strong>@item.Name</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(item.Status ? "bg-success" : "bg-danger")">
                                            @(item.Status ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-outline-info btn-sm" data-bs-toggle="tooltip" title="View Details">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip" title="Edit">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-outline-danger btn-sm" data-bs-toggle="tooltip" title="Delete" onclick="return confirm('Are you sure you want to delete this author?');">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                rowNumber++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-x text-muted display-4 mb-3"></i>
                    <h5 class="text-muted">No Authors Found</h5>
                    <p class="mb-3">Start by creating your first author</p>
                    <a asp-action="Create" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-lg me-2"></i> Create New Author
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 16px;
    }

    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .btn-group .btn {
        padding: 0.375rem 0.75rem;
    }

    .card {
        border: none;
        border-radius: 8px;
    }

    .card-header {
        border-bottom: 1px solid #e9ecef;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.2s ease;
    }

    .badge {
        padding: 0.5rem 0.75rem;
        font-weight: 500;
        font-size: 0.75rem;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            $('#example').DataTable({
                "order": [[1, "asc"]],
                "pageLength": 25,
                "language": {
                    "search": "Search Authors:",
                    "lengthMenu": "Show _MENU_ authors per page",
                    "info": "Showing _START_ to _END_ of _TOTAL_ authors",
                    "infoEmpty": "No authors available",
                    "infoFiltered": "(filtered from _MAX_ total authors)"
                },
                "columnDefs": [
                    { "orderable": false, "targets": [0, 3] }
                ]
            });
        });
    </script>
}
