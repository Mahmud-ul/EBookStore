@model IEnumerable<EBookStore.Models.PaymentMethod>

@{
    ViewData["Title"] = "Payment Methods";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container">
    <!-- Page title and Create button -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start mb-3">
        <h3 class="fw-bold mb-2 mb-md-0"><i class="bi bi-credit-card-2-front-fill me-2"></i> Payment Methods</h3>
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Create New
        </a>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient-secondary rounded-top">
            <small>All Payment Methods (Total: @(Model?.Count() ?? 0))</small>
        </div>

        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table id="example" class="table table-hover table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>
                                        <span class="badge @(item.Status ? "bg-success" : "bg-danger")">
                                            @(item.Status ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details"
                                               asp-route-id="@item.ID"
                                               class="btn btn-sm btn-info text-white"
                                               title="View Details">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit"
                                               asp-route-id="@item.ID"
                                               class="btn btn-sm btn-warning text-white"
                                               title="Edit">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-id="@item.ID"
                                               class="btn btn-sm btn-danger"
                                               title="Delete"
                                               onclick="return confirm('Are you sure you want to delete this payment method?');">
                                                <i class="bi bi-trash-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-credit-card-2-front text-muted display-4 mb-3"></i>
                    <h5 class="text-muted">No payment methods found</h5>
                    <p class="mb-3">Start by creating your first payment method</p>
                    <a asp-action="Create" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-lg me-2"></i> Create New Payment Method
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 8px;
    }

    .card-header {
        border-bottom: 1px solid #e9ecef;
    }

    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.2s ease;
    }

    .btn-group .btn {
        padding: 0.35rem 0.7rem;
    }

    .badge {
        padding: 0.5rem 0.75rem;
        font-weight: 500;
        font-size: 0.75rem;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#example').DataTable({
                "order": [[0, "asc"]],
                "pageLength": 25,
                "language": {
                    "search": "Search Payment Methods:",
                    "lengthMenu": "Show _MENU_ per page",
                    "info": "Showing _START_ to _END_ of _TOTAL_ payment methods",
                    "infoEmpty": "No payment methods available",
                    "infoFiltered": "(filtered from _MAX_ total)"
                },
                "columnDefs": [
                    { "orderable": false, "targets": [2] }
                ]
            });
        });
    </script>
}
