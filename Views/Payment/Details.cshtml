@model EBookStore.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container">
    <div class="card shadow-sm border-0 rounded-4 p-2">
        <!-- Card header -->
        <div class="card-header bg-gradient-primary rounded-top mb-4">
            <h5 class="mb-0"><i class="fa fa-money-bill-wave me-2"></i> Payment Details</h5>
        </div>

        <!-- Card body -->
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Payment Date</dt>
                <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.PaymentDate)</dd>

                <dt class="col-sm-3 text-muted">Order ID</dt>
                <dd class="col-sm-9 fw-bold">
                    @(Model.Order != null ? Model.Order.ID.ToString() : "N/A")
                </dd>

                <dt class="col-sm-3 text-muted">Delivery Charge</dt>
                <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.DelivaryCharge)</dd>

                <dt class="col-sm-3 text-muted">Total Amount</dt>
                <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.TotalAmount)</dd>

                <dt class="col-sm-3 text-muted">Extra</dt>
                <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.Extra)</dd>
            </dl>

            <!-- Action buttons below -->
            <div class="mt-5 d-flex gap-3">
                <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-warning">
                    <i class="fa fa-edit me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .card-header {
        font-weight: 600;
    }

    .badge {
        font-size: 0.9rem;
        padding: 0.5rem 0.75rem;
    }
</style>
