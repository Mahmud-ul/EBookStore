@model EBookStore.Models.Payment

@{
    ViewData["Title"] = "Delete Payment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4">
        <!-- Card header -->
        <div class="card-header text-white rounded-top-4" style="background: linear-gradient(90deg, #dc3545, #b02a37);">
            <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Payment</h4>
        </div>

        <!-- Card body -->
        <div class="card-body p-4">
            <h5 class="mb-4">Are you sure you want to delete this payment?</h5>

            <dl class="row mb-4">
                <dt class="col-sm-3 fw-semibold">Date of Payment</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.PaymentDate)</dd>

                <dt class="col-sm-3 fw-semibold">Order ID</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Order.ID)</dd>

                <dt class="col-sm-3 fw-semibold">Delivary Charge</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.DelivaryCharge)</dd>

                <dt class="col-sm-3 fw-semibold">Total Amount</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.TotalAmount)</dd>

                <dt class="col-sm-3 fw-semibold">@Html.DisplayNameFor(model => model.Extra)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Extra)</dd>
            </dl>

            <form asp-action="Delete" class="d-flex gap-3">
                <input type="hidden" asp-for="ID" />
                <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                    <i class="bi bi-trash-fill me-1"></i> Delete
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left-circle me-1"></i> Back
                </a>
            </form>
        </div>
    </div>
</div>
