@model EBookStore.Models.Cart

@{
    ViewData["Title"] = "Cart Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container">
    <div class="card shadow-sm border-0 rounded-4 p-2">
        <!-- Card header -->
        <div class="card-header bg-gradient-primary rounded-top mb-4">
            <h5 class="mb-0"><i class="fa fa-shopping-cart me-2"></i> Cart Details</h5>
        </div>

        <!-- Card body -->
        <div class="card-body">
            <dl class="row mb-0">

                <dt class="col-sm-3 text-muted">Product</dt>
                <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.Product.Name)</dd>

                <dt class="col-sm-3 text-muted">User</dt>
                <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.User.Email)</dd>

                <dt class="col-sm-3 text-muted">Quantity</dt>
                <dd class="col-sm-9 fw-bold">@Html.DisplayFor(model => model.Quantity)</dd>

                <dt class="col-sm-3 text-muted">Image</dt>
                <dd class="col-sm-9">
                    @if (Model.Product.Image != null && Model.Product.Image.Length > 0)
                    {
                        <img id="preview" src="@Model.Product.Image" class="img-fluid" style="max-height:100px;" alt="No Image" />
                    }
                    else
                    {
                        <img id="preview" src="\Images\NoImage.jpg" class="img-fluid" style="max-height:100px;" alt="No Image" />
                    }
                </dd>
            </dl>

            <!-- Action buttons below -->
            <div class="mt-5 d-flex gap-3">
                <a asp-action="Edit" asp-route-id="@Model?.ID" class="btn btn-warning">
                    <i class="fa fa-edit me-1"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .card-header {
        font-weight: 600;
    }
</style>
