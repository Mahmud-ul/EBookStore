@model IEnumerable<EBookStore.Models.Cart>
@{
    ViewData["Title"] = "My Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(90deg, #00b4d8, #007bff);">
            <h4 class="mb-0 fw-semibold"><i class="bi bi-cart4 me-2"></i>My Shopping Cart</h4>
        </div>

        <div class="card-body p-4 bg-light">
            @if (!Model.Any())
            {
                <div class="alert alert-info text-center rounded-3 py-4 shadow-sm">
                    <i class="bi bi-info-circle-fill me-2"></i>Your cart is empty.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-borderless align-middle text-center" id="cartTable">
                        <thead class="bg-white shadow-sm border rounded-3">
                            <tr class="fw-semibold text-secondary">
                                <th class="text-start ps-4">Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white rounded-4 shadow-sm">
                            @foreach (var item in Model)
                            {
                                var product = item.Product!;
                                var price = product.Discount.HasValue ? product.Price - product.Discount.Value : product.Price;
                                <tr data-cart-id="@item.ID" class="border-bottom">
                                    <td class="text-start ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@(!string.IsNullOrEmpty(product.Image) ? product.Image : "/images/no-image.png")"
                                                 alt="@product.Name"
                                                 style="width:80px; height:100px; object-fit:cover; border-radius:10px; box-shadow:0 2px 5px rgba(0,0,0,0.15);">
                                            <div>
                                                <h6 class="fw-semibold mb-1">@product.Name</h6>
                                                <small class="text-muted">@product.Category?.Name</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="fw-semibold text-primary">৳@price</td>
                                    <td>
                                        <div class="qty-controls mx-auto">
                                            <button type="button" class="qty-btn decrease" title="Decrease"><i class="bi bi-dash-lg"></i></button>
                                            <input type="number" class="qty-input" value="@item.Quantity" min="1" max="99" readonly>
                                            <button type="button" class="qty-btn increase" title="Increase"><i class="bi bi-plus-lg"></i></button>
                                        </div>
                                    </td>
                                    <td class="fw-semibold text-success item-total">৳@(price* item.Quantity)</td>
                                    <td>
                                        <button type="button" class="btn btn-outline-danger btn-sm remove-item" title="Remove item">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap mt-4 p-3 rounded-3 bg-white shadow-sm">
                    <h5 class="fw-semibold mb-0">
                        <span class="text-muted">Total:</span>
                        <span id="cartTotal" class="text-primary ms-2">
                            ৳@Model.Sum(c => (c.Product!.Discount.HasValue ? c.Product.Price - c.Product.Discount.Value : c.Product.Price) * c.Quantity)
                        </span>
                    </h5>

                    <a class="btn btn-lg px-4 rounded-3 shadow-sm gradient-btn" asp-action="PlaceOrder" asp-controller="Order" style="background-color:purple;">
                        <i class="bi bi-bag-check-fill me-2"></i>Place Order
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .gradient-btn {
        background: linear-gradient(135deg, #8a2be2, #6a0dad);
        border: none;
        color: white;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(138, 43, 226, 0.3);
    }

        .gradient-btn:hover {
            background: linear-gradient(135deg, #007bff, #00c6ff);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(138, 43, 226, 0.4);
        }

        .gradient-btn:active {
            transform: translateY(0);
            box-shadow: 0 2px 10px rgba(138, 43, 226, 0.3);
        }
    .qty-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f3f5;
        border-radius: 12px;
        width: 120px;
        overflow: hidden;
        box-shadow: inset 0 0 5px rgba(0, 0, 0, 0.05);
    }

    .qty-btn {
        width: 45px;
        height: 45px;
        border: none;
        background: linear-gradient(135deg, #007bff, #00c6ff);
        color: #fff;
        font-size: 24px;
        font-weight: 400;
        line-height: 1;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

    .qty-btn:hover {
        background: linear-gradient(135deg, #0056b3, #0099cc);
    }

    .qty-btn:active {
        transform: scale(0.95);
    }

    .qty-input {
        width: 70px;
        height: 45px;
        border: none;
        text-align: center;
        font-size: 18px;
        font-weight: 700;
        outline: none;
        background: #fff;
        line-height: 45px;
        padding: 0;
        margin: 0;
        vertical-align: middle;
    }

    /* Remove spinner arrows from number input */
    .qty-input::-webkit-outer-spin-button,
    .qty-input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .qty-input[type=number] {
        -moz-appearance: textfield;
    }

    .btn-outline-danger {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.3s;
    }

    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: #fff;
        transform: scale(1.15);
        box-shadow: 0 2px 6px rgba(220, 53, 69, 0.4);
    }

    #cartTable tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.3s ease-in-out;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Increase quantity
            $('.increase').click(function () {
                var row = $(this).closest('tr');
                updateQuantity(row, 1);
            });

            // Decrease quantity
            $('.decrease').click(function () {
                var row = $(this).closest('tr');
                updateQuantity(row, -1);
            });

            // Remove item
            $('.remove-item').click(function () {
                var row = $(this).closest('tr');
                var cartId = row.data('cart-id');
                $.ajax({
                    url: '/Cart/Remove',
                    type: 'POST',
                    data: { id: cartId },
                    success: function (response) {
                        row.fadeOut(300, function () {
                            $(this).remove();
                            updateCartTotal();
                            $("#cart").text("Cart: (BDT " + response.totalCart + ")");
                        });
                    },
                    error: function () {
                        alert('Failed to remove item.');
                    }
                });
            });

            function updateQuantity(row, change) {
                var input = row.find('.qty-input');
                var qty = parseInt(input.val());
                qty = Math.min(99, Math.max(1, qty + change));
                input.val(qty);

                var cartId = row.data('cart-id');

                $.ajax({
                    url: '/Cart/UpdateQuantity',
                    type: 'POST',
                    data: { id: cartId, quantity: qty },
                    success: function (response) {
                        updateItemTotal(row, qty);
                        updateCartTotal();
                        $("#cart").text("Cart: (BDT " + response.totalCart + ")");
                    },
                    error: function () {
                        alert('Failed to update quantity.');
                    }
                });
            }

            function updateItemTotal(row, qty) {
                var priceText = row.find('td:nth-child(2)').text().replace(/[^\d]/g, '');
                var price = parseInt(priceText);
                row.find('.item-total').text('৳' + (price * qty));
            }

            function updateCartTotal() {
                var total = 0;
                $('#cartTable tbody tr').each(function () {
                    var itemTotal = $(this).find('.item-total').text().replace(/[^\d]/g, '');
                    total += parseInt(itemTotal);
                });
                $('#cartTotal').text('৳' + total);
            }            
        });
    </script>
}
