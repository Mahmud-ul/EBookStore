@model IEnumerable<EBookStore.Models.Cart>

@{
    ViewData["Title"] = "Cart Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int grandTotal = 0;
}

<div class="container">
    <!-- Page title and Create button -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start mb-3">
        <h3 class="fw-bold mb-2 mb-md-0"><i class="bi bi-cart-fill me-2"></i> Cart Management</h3>
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Create New
        </a>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient-secondary rounded-top">
            <small>All cart items (Total: @(Model?.Count() ?? 0))</small>
        </div>

        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle" id="example">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Price</th>
                                <th>Actual Price</th>
                                <th>Discount</th>
                                <th>Total</th>
                                <th>User</th>
                                <th>Email</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                { grandTotal += item.Product != null ? ((item.Product.Price - (item.Product.Discount ?? 0)) * item.Quantity) : 0; }
                                <tr>
                                    <td>
                                        <a asp-action="Details" asp-controller="Product" asp-route-id="@item.ProductID" class="text-decoration-none">
                                            @(item.Product?.Name ?? "N/A")
                                        </a>
                                    </td>
                                    <td>@item.Quantity</td>
                                    <td>@(item.Product != null ? (item.Product.Price - (item.Product.Discount ?? 0)) : 0)</td>
                                    <td>@(item.Product?.Price ?? 0)</td>
                                    <td>@(item.Product?.Discount ?? 0)</td>
                                    <td>@(item.Product != null ? ((item.Product.Price - (item.Product.Discount ?? 0)) * item.Quantity) : 0)</td>
                                    <td>@(item.User?.Name ?? "N/A")</td>
                                    <td>@(item.User?.Email ?? "N/A")</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info" title="Details">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning" title="Edit">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            @* <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this item?');">
                                                <i class="bi bi-trash-fill"></i>
                                            </a> *@
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light fw-bold">
                                <td colspan="5" class="text-end">Grand Total:</td>
                                <td>@grandTotal</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-cart-x text-muted display-4 mb-3"></i>
                    <h5 class="text-muted">No cart items found</h5>
                    <p class="mb-3">Add products to the cart to start</p>
                    <a asp-action="Create" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-lg me-2"></i> Create New
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 8px;
    }

    .card-header {
        border-bottom: 1px solid #e9ecef;
    }

    .table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
        transition: background-color 0.2s ease;
    }

    .btn-group .btn {
        padding: 0.35rem 0.7rem;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            $('#example').DataTable({
                "order": [[0, "asc"]],
                "pageLength": 25,
                "language": {
                    "search": "Search Cart Items:",
                    "lengthMenu": "Show _MENU_ items per page",
                    "info": "Showing _START_ to _END_ of _TOTAL_ items",
                    "infoEmpty": "No items available",
                    "infoFiltered": "(filtered from _MAX_ total items)"
                },
                "columnDefs": [
                    { "orderable": false, "targets": [8] }
                ]
            });
        });
    </script>
}
