@model IEnumerable<EBookStore.Models.Cart>
@{
    ViewData["Title"] = "Cart Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int grandTotal = 0;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Cart Management</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa fa-plus"></i> Create New
        </a>
    </div>

    <div class="card">
        <div class="card-body">           
            <table id="example" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>@Html.DisplayNameFor(model => model.Quantity)</th>
                        <th>Price</th>
                        <th>ActualPrice</th>
                        <th>Discount</th>
                        <th>Total</th>                       
                        <th>User</th>
                        <th>Email</th>
                        
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            {grandTotal += item.Product != null ? ((item.Product.Price - (item.Product.Discount ?? 0)) * item.Quantity) : 0;}
                            <tr>
                                <td>
                                    <a asp-action="Details"
                                       asp-controller="Product"
                                       asp-route-id="@item.ProductID"
                                       class="text-decoration-none">
                                        @(item.Product?.Name ?? "N/A")
                                    </a>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                                <td>@(item.Product != null ? (item.Product.Price - (item.Product.Discount ?? 0)) : 0)</td>
                                <td>@(item.Product != null ? item.Product.Price : 0)</td>
                                <td>@(item.Product != null ? item.Product.Discount : 0)</td>
                                <td>@(item.Product != null ? ((item.Product.Price - (item.Product.Discount ?? 0))*item.Quantity) : 0)</td>
                                <td>@(item.User?.Name ?? "N/A")</td>
                                <td>@(item.User?.Email ?? "N/A")</td>                               
                                <td class="text-center">
                                    <a asp-action="Details"
                                       asp-route-id="@item.ID"
                                       class="btn btn-sm btn-info"
                                       title="Details">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit"
                                       asp-route-id="@item.ID"
                                       class="btn btn-sm btn-warning"
                                       title="Edit">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete"
                                       asp-route-id="@item.ID"
                                       class="btn btn-sm btn-danger"
                                       title="Delete">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                <i class="fa fa-shopping-cart fa-3x mb-3 d-block"></i>
                                No cart items found
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light fw-bold">
                        <td colspan="5" class="text-end">Grand Total:</td>
                        <td>
                            @grandTotal
                        </td>
                        <td colspan="3"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>