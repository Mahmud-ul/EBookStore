						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

@section Scripts {
	<script>
		jQuery(document).ready(function(){

			function showNotification(message, type) {
				var $notif = $("#cartNotification");
				$notif.stop(true, true);
				$notif.text(message);

				if(type === 'success') {
					$notif.css('background-color', '#28a745'); // green
				} else if(type === 'info') {
					$notif.css('background-color', '#17a2b8'); // blue
				} else if(type === 'error') {
					$notif.css('background-color', '#dc3545'); // red
				}

				$notif.fadeIn(400).delay(2000).fadeOut(400);
			}

			jQuery(".Cart").click(function(){
				var $btn = $(this);
				var originalText = $btn.text();
				var originalColor = $btn.css('background-color');
				var id = $btn.attr("id");

				$.ajax({
					url:'@Url.Action("AddToCart", "Cart")',
					type: "POST",
					data:{id: id},
					success:function(response){
						if (response.success) {
							$("#cart").text("Cart: (BDT " + response.totalCart + ")");
							showNotification("Item added to cart!", "success");

							$btn.text("Added!").css('background-color', '#28a745').prop("disabled", true);
						} else if(response.requiresLogin) {
							showNotification("Please log in to add items!", "info");

							$btn.text("Login Required").css('background-color', '#ffc107').prop("disabled", true);
						} else {
							showNotification(response.message, "info");

							$btn.text("Already in Cart").css('background-color', '#17a2b8').prop("disabled", true);
						}

						// Reset button after 2 seconds
						setTimeout(function(){
							$btn.text(originalText).css('background-color', originalColor).prop("disabled", false);
						}, 2000);
					},
					error:function(xhr, status, error){
						console.error("Error:", error);
						showNotification("Something went wrong!", "error");

						$btn.text("Error!").css('background-color', '#dc3545').prop("disabled", true);
						setTimeout(function(){
							$btn.text(originalText).css('background-color', originalColor).prop("disabled", false);
						}, 2000);
					}
				});
			});

		});
	</script>

	<script>
		$(document).ready(function() {
			// Auto-click the "next" button every 3 seconds
			setInterval(function() {
				$('.next.slick-arrow').click();
			}, 5000);
		});
	</script>
}
