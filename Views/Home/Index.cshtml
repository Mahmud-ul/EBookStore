									<figcaption>
										<h3><a asp-action="ProductDetails" asp-controller="Product" asp-route-id="@item.ID" style="text-decoration:none;">@item.Name</a></h3>
										<span>@(item.Author != null ? item.Author.Name : "N/A")</span>
										<div class="item-price">
