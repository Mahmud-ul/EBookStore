@{
	ViewData["Title"] = "Home Page";
	Layout = "~/Views/Shared/_Layout.cshtml";
	var SlideShow = ViewBag.SlideShow as IEnumerable<Product>;
	var Featured = ViewBag.Featured as IEnumerable<Product>;
	var BestSeller = ViewBag.BestSeller as Product;
	var Popular = ViewBag.Popular as IEnumerable<Product>;
	var Discount = ViewBag.Discount as IEnumerable<Product>;

	var Category = ViewBag.Category as IEnumerable<Category>;
}

<!--Index-->
<section id="billboard">
	<div class="container">
		<div class="row">
			<div class="col-md-12">

				<button class="prev slick-arrow">
					<i class="icon icon-arrow-left"></i>
				</button>

				<div class="main-slider pattern-overlay">
					@if(SlideShow != null && SlideShow.Any())
					{
						foreach (var item in SlideShow)
						{
							<div class="slider-item">
								<div class="banner-content">
									<h2 class="banner-title">@item.Name</h2>
									<p>
										@item.Description
									</p>
									<div class="btn-wrap">
										<a asp-action="About" asp-controller="Product" asp-route-id="@item.ID" class="btn btn-outline-accent btn-accent-arrow">
											Read More<i class="icon icon-ns-arrow-right"></i>
										</a>
									</div>
								</div><!--banner-content-->
								<div style="max-width:600px;">
									<img src="@item.Image" alt="banner" class="banner-image">
								</div>
								
							</div>
							<!--slider-item-->
						}
					}								

				</div><!--slider-->

				<button class="next slick-arrow">
					<i class="icon icon-arrow-right"></i>
				</button>

			</div>
		</div>
	</div>

</section>

<section id="client-holder" data-aos="fade-up">
	<div class="container">
		<div class="row">
			<div class="inner-content">
				<div class="logo-wrap">
					<div class="grid">
						<a href="#"><img src="images/client-image1.png" alt="client"></a>
						<a href="#"><img src="images/client-image2.png" alt="client"></a>
						<a href="#"><img src="images/client-image3.png" alt="client"></a>
						<a href="#"><img src="images/client-image4.png" alt="client"></a>
						<a href="#"><img src="images/client-image5.png" alt="client"></a>
					</div>
				</div><!--image-holder-->
			</div>
		</div>
	</div>
</section>

<section id="featured-books" class="py-5 my-5">
	<div class="container">
		<div class="row">
			<div class="col-md-12">

				<div class="section-header align-center">
					<div class="title">
						<span>Some quality items</span>
					</div>
					<h2 class="section-title">Featured Books</h2>
				</div>

				<div class="product-list" data-aos="fade-up">
					<div class="row">
						@if (Featured != null && Featured.Any())
						{
							foreach (var item in Featured)
							{
								<div class="col-md-3">
									<div class="product-item">
										<figure class="product-style">
											<img src="@item.Image" alt="Books" class="product-item">
											<button type="button" class="add-to-cart Cart" data-product-tile="add-to-cart" id="@item.ID">
												Add to
												Cart
											</button>
										</figure>
										<figcaption>
											<h3>@item.Name</h3>
											<span>@(item.Author!=null? item.Author.Name : "N/A")</span>
											<div class="item-price">BDT @item.Price</div>
										</figcaption>
									</div>
								</div>
							}
						}

					</div><!--ft-books-slider-->
				</div><!--grid-->


			</div><!--inner-content-->
		</div>

		<div class="row">
			<div class="col-md-12">

				<div class="btn-wrap align-right">
					<a href="#" class="btn-accent-arrow">
						View all products <i class="icon icon-ns-arrow-right"></i>
					</a>
				</div>

			</div>
		</div>
	</div>
</section>

<section id="best-selling" class="leaf-pattern-overlay">
	<div class="corner-pattern-overlay"></div>
	<div class="container">
		<div class="row justify-content-center">

			<div class="col-md-8">

				<div class="row">
					@if (BestSeller != null)
					{
						<div class="col-md-6">
							<figure class="products-thumb">
								<img src="@BestSeller.Image" alt="book" class="single-image">
							</figure>
						</div>

						<div class="col-md-6">
							<div class="product-entry">
								<h2 class="section-title divider">Best Selling Book</h2>
								<div class="products-content">
								<div class="author-name">By @(BestSeller.Author!= null? BestSeller.Author.Name : "N/A")</div>
									<h3 class="item-title">@BestSeller.Name</h3>
									<p>
										@BestSeller.Description
									</p>
									<div class="item-price">BDT @BestSeller.Price</div>
									<div class="btn-wrap">
										<a href="#" class="btn-accent-arrow">
											shop it now <i class="icon icon-ns-arrow-right"></i>
										</a>
									</div>
								</div>
							</div>
						</div>
					}

				</div>
				<!-- / row -->

			</div>

		</div>
	</div>
</section>

<section id="popular-books" class="bookshelf py-5 my-5">
	<div class="container">
		<div class="row">
			<div class="col-md-12">

				<div class="section-header align-center">
					<div class="title">
						<span>Some quality items</span>
					</div>
					<h2 class="section-title">Popular Books</h2>
				</div>

				<ul class="tabs">
					@if (Category != null && Category.Any())
					{
						<li data-tab-target="#all-genre" class="active tab">All Genre</li>
						foreach(var i in Category)
						{
							<li data-tab-target="#@i.Name" class="tab">@i.Name</li>
						}
					}									
				</ul>

				<div class="tab-content">
					@if (Category != null && Category.Any() && Popular != null && Popular.Any())
					{
						<div id="all-genre" data-tab-content class="active">
							<div class="row">
								@foreach (var item2 in Popular)
								{
									<div class="col-md-3">
										<div class="product-item">
											<figure class="product-style">
												<img src="@item2.Image" alt="Books" class="product-item">
												<button type="button" class="add-to-cart Cart" data-product-tile="add-to-cart" id="@item2.ID">
													Add to
													Cart
												</button>
											</figure>
											<figcaption>
												<h3>@item2.Name</h3>
												<span>@(item2.Author != null? item2.Author.Name : "N/A")</span>
												<div class="item-price">BDT @item2.Price</div>
											</figcaption>
										</div>
									</div>
								}
							</div>

						</div>
						foreach (var item in Category)
						{
							<div id="@item.Name" data-tab-content>
								<div class="row">
									@foreach (var item2 in Popular)
									{
										if (item2.Category != null && item2.Category.Name == item.Name)
										{
											<div class="col-md-3">
												<div class="product-item">
													<figure class="product-style">
														<img src="@item2.Image" alt="Books" class="product-item">
														<button type="button" class="add-to-cart Cart" data-product-tile="add-to-cart" id="@item2.ID">
															Add to
															Cart
														</button>
													</figure>
													<figcaption>
														<h3>@item2.Name</h3>
														<span>@(item2.Author != null ? item2.Author.Name : "N/A")</span>
														<div class="item-price">BDT @item2.Price</div>
													</figcaption>
												</div>
											</div>
										}	
									}
								</div>
							</div>
						}
					}

				</div>

			</div><!--inner-tabs-->

		</div>
	</div>
</section>

<section id="quotation" class="align-center pb-5 mb-5">
	<div class="inner-content">
		<h2 class="section-title divider">Quote of the day</h2>
		<blockquote data-aos="fade-up">
			<q>
				“The more that you read, the more things you will know. The more that you learn, the more places
				you’ll go.”
			</q>
			<div class="author-name">Dr. Seuss</div>
		</blockquote>
	</div>
</section>

<section id="special-offer" class="bookshelf pb-5 mb-5">

	<div class="section-header align-center">
		<div class="title">
			<span>Grab your opportunity</span>
		</div>
		<h2 class="section-title">Books with offer</h2>
	</div>

	<div class="container">
		<div class="row">
			<div class="inner-content">
				<div class="product-list" data-aos="fade-up">
					<div class="grid product-grid">
						@if (Discount != null && Discount.Any())
						{
							foreach (var item in Discount)
							{
								<div class="product-item">
									<figure class="product-style">
										<img src="@item.Image" alt="Books" class="product-item">
										<button type="button" class="add-to-cart Cart" data-product-tile="add-to-cart" id="@item.ID">
											Add to
											Cart
										</button>
									</figure>
									<figcaption>
										<h3>@item.Name</h3>
										<span>@(item.Author != null ? item.Author.Name : "N/A")</span>
										<div class="item-price">
											<span class="prev-price">BDT @item.Price</span>BDT @(item.Price-item.Discount)
										</div>
									</figcaption>
								</div>
							}
						}
					</div><!--grid-->
				</div>
			</div><!--inner-content-->
		</div>
	</div>
</section>

@section Scripts {
	<script>
		jQuery(document).ready(function(){
			jQuery(".Cart").click(function(){
				var id = $(this).attr("id");
				//alert("successfully clicked! " + id);
				$.ajax({
					url:'@Url.Action("AddToCart", "Product")',
					type: "POST",
					data:{id: id},
					success:function(response){
						if (response.success) {
							alert(response.message); // Item added to cart!
						$("#cart").text("Cart: (BDT " + response.totalCart + ")");
						}	 
						else {
							alert(response.message);
						}
					},
					error:function(xhr, status, error){
						console.error("Error:", error);
					}
				});
			});
		});	
	</script>
}