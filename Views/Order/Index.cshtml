    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-gradient-secondary rounded-top">
            <small>All orders (Total: @(Model?.Count() ?? 0))</small>
        </div>

        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle" id="example">
                        <thead class="table-light">
                            <tr>
                                <th>Order No.</th>
                                <th>Order Date</th>
                                <th>Status Date</th>
                                <th>Status</th>
                                <th>Total Amount</th>
                                <th>Customer Name</th>
                                <th>Phone</th>
                                <th>City</th>
                                <th>Area</th>
                                <th>Address</th>
                                <th>Payment Method</th>
                                <th>Delivery Charge</th>
                                <th>User Email</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>#@(10000 + item.ID)</td>
                                    <td>@item.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td>@item.StatusDate?.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td>
                                        <span class="badge @(item.Status == "Pending" ? "bg-warning text-dark" :
                                                                                                             item.Status == "OnGoing" ? "bg-info text-dark" :
                                                                                                             item.Status == "Delivered" ? "bg-success" :
                                                                                                             item.Status == "Canceled" ? "bg-danger" : "bg-secondary")">
                                    @item.Status
                                </span>
                            </td>
                            <td>৳@item.TotalAmount</td>
                            <td>@item.Name</td>
                            <td>@item.Phone</td>
                            <td>@item.City</td>
                            <td>@item.Area</td>
                            <td>@item.Address</td>
                            <td>@item.PaymentMethod</td>
                            <td>৳@item.DeliveryCharge</td>
                            <td>@(item.User?.Email ?? "N/A")</td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info" title="Details">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning" title="Edit">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this order?');">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-receipt-cutoff text-muted display-4 mb-3"></i>
                    <h5 class="text-muted">No orders found</h5>
                    <p class="mb-3">Start by creating your first order</p>
                    <a asp-action="Create" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-lg me-2"></i> Create New Order
                    </a>
                </div>
            }
        </div>
    </div>
</div>

