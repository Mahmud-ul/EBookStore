@model EBookStore.Models.Order
@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <style>
        /* Back Button */
        .btn-back {
            background: #EDEBE4;
            color: #5C4033;
            border: none;
            padding: 8px 20px;
            border-radius: 25px;
            transition: all 0.3s ease;
        }

            .btn-back:hover {
                background: #C5A992;
                color: #fff;
                transform: translateX(-3px);
            }

        /* Order Card */
        .order-card {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            height: 100%;
        }

        .order-card-header {
            background: #C5A992;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: none;
        }

            .order-card-header i {
                font-size: 20px;
                color: #fff;
            }

            .order-card-header h5 {
                color: #fff;
                font-weight: 600;
            }

        .order-card-body {
            padding: 20px;
        }

        /* Info Rows */
        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #EDEBE4;
        }

            .info-row:last-child {
                border-bottom: none;
            }

        .info-label {
            font-weight: 600;
            color: #6c757d;
            font-size: 14px;
        }

        .info-value {
            color: #5C4033;
            font-weight: 500;
            text-align: right;
        }

        .total-amount {
            font-size: 20px;
            font-weight: 700;
            color: #8B5E3C;
        }

        /* Status Badges */
        .status-badge {
            display: inline-block;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-pending {
            background: #FFF3E0;
            color: #FF9800;
        }

        .status-ongoing {
            background: #E3F2FD;
            color: #2196F3;
        }

        .status-canceled {
            background: #FFEBEE;
            color: #F44336;
        }

        .status-delivered {
            background: #E8F5E9;
            color: #4CAF50;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-invoice {
            background: #C5A992;
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-invoice:hover {
                background: #A67B5B;
                transform: translateY(-2px);
            }

        .btn-cancel {
            background: #dc3545;
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-cancel:hover {
                background: #c82333;
                transform: translateY(-2px);
            }

        /* Order Items Table */
        .order-items-table {
            width: 100%;
            border-collapse: collapse;
        }

            .order-items-table thead tr {
                background: #EDEBE4;
            }

            .order-items-table th {
                padding: 12px 16px;
                text-align: left;
                font-weight: 600;
                color: #5C4033;
                font-size: 14px;
            }

            .order-items-table td {
                padding: 16px;
                border-bottom: 1px solid #EDEBE4;
                vertical-align: middle;
            }

        .product-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .product-thumb {
            width: 60px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .product-name {
            font-size: 14px;
            font-weight: 600;
            color: #5C4033;
            margin-bottom: 5px;
        }

        .product-category {
            font-size: 12px;
            color: #6c757d;
        }

        .price, .quantity {
            color: #6c757d;
            font-weight: 500;
        }

        .total {
            font-weight: 700;
            color: #8B5E3C;
        }

        .order-items-table tfoot tr td {
            border-bottom: none;
            padding: 10px 16px;
        }

        .grand-total {
            background: #EDEBE4;
        }

            .grand-total td {
                font-size: 16px;
                color: #8B5E3C;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .product-info {
                flex-direction: column;
                align-items: flex-start;
                text-align: left;
            }

            .product-thumb {
                width: 50px;
                height: 65px;
            }

            .order-items-table th,
            .order-items-table td {
                padding: 10px;
            }

            .info-row {
                flex-direction: column;
                align-items: flex-start;
                gap: 5px;
            }

            .info-value {
                text-align: left;
            }
        }
    </style>
}

<div class="container my-2">
    <!-- Back Button -->
    <div class="mb-4">
        <a asp-action="OrderList" class="btn btn-back">
            <i class="bi bi-arrow-left"></i> Back to Orders
        </a>
    </div>

    <div class="row">
        <!-- Order Info Card -->
        <div class="col-md-6 mb-4">
            <div class="order-card">
                <div class="order-card-header">
                    <i class="bi bi-receipt"></i>
                    <h5 class="mb-0">Order Information</h5>
                </div>
                <div class="order-card-body">
                    <div class="info-row">
                        <span class="info-label">Order No:</span>
                        <span class="info-value">@(Model.ID+1000)</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Order Date:</span>
                        <span class="info-value">@Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Status:</span>
                        <span class="status-badge status-@Model.Status.ToLower()">@Model.Status</span>
                    </div>
                    @if (Model.StatusDate.HasValue)
                    {
                        <div class="info-row">
                            <span class="info-label">Status Update:</span>
                            <span class="info-value">@Model.StatusDate.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="order-card">
                <div class="order-card-header">
                    <i class="bi bi-geo-alt"></i>
                    <h5 class="mb-0">Shipping Information</h5>
                </div>
                <div class="order-card-body">
                    <div class="info-row">
                        <span class="info-label">Full Name:</span>
                        <span class="info-value">@Model.Name</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Phone:</span>
                        <span class="info-value">@Model.Phone</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">City:</span>
                        <span class="info-value">@Model.City</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Area:</span>
                        <span class="info-value">@Model.Area</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Address:</span>
                        <span class="info-value">@Model.Address</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Items Card -->
    <div class="order-card mb-4">
        <div class="order-card-header">
            <i class="bi bi-box-seam"></i>
            <h5 class="mb-0">Order Items</h5>
        </div>
        <div class="order-card-body p-0">
            <div class="table-responsive">
                <table class="order-items-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderProducts != null && Model.OrderProducts.Any())
                        {
                            foreach (var item in Model.OrderProducts)
                            {
                                <tr>
                                    <td>
                                        <div class="product-info">
                                            <img src="@(!string.IsNullOrEmpty(item.Product?.Image) ? item.Product.Image : "/images/no-image.png")"
                                                 alt="@item.Product?.Name"
                                                 class="product-thumb">
                                            <div>
                                                <h6 class="product-name">@item.Product?.Name</h6>
                                                @if (item.Product?.Category != null)
                                                {
                                                    <small class="product-category">@item.Product.Category.Name</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="price">৳@item.Price.ToString("N0")</td>
                                    <td class="quantity">x @item.Quantity</td>
                                    <td class="total">৳@((item.Price * item.Quantity).ToString("N0"))</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4">No items found.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Subtotal:</td>
                            <td class="fw-bold">৳@((Model.TotalAmount - Model.DeliveryCharge).ToString("N0"))</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Delivery Charge:</td>
                            <td class="fw-bold">৳@Model.DeliveryCharge.ToString("N0")</td>
                        </tr>
                        <tr class="grand-total">
                            <td colspan="3" class="text-end fw-bold">Grand Total:</td>
                            <td class="fw-bold">৳@Model.TotalAmount.ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cancelOrder(orderId) {
            if (confirm('Are you sure you want to cancel this order?')) {
                $.ajax({
                    url: '/Order/Cancel/' + orderId,
                    type: 'POST',
                    success: function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Failed to cancel order. Please try again.');
                        }
                    },
                    error: function () {
                        alert('An error occurred. Please try again.');
                    }
                });
            }
        }
    </script>
}