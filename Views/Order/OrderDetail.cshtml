@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var order = ViewBag.Order as EBookStore.Models.Order;
    var products = ViewBag.Products as IEnumerable<EBookStore.Models.OrderProduct>;
}

@if (order != null)
{
    <div class="container my-5">
        <div class="card shadow-lg border-0">
            <!-- Header -->
            <div class="card-header bg-gradient-success text-white d-flex justify-content-between align-items-center rounded-top">
                <h3 class="mb-0">
                    <i class="bi bi-receipt-cutoff me-2"></i> Order Details
                </h3>
                <span class="small text-white-50">Order #@(10000 + order.ID)</span>
            </div>

            <!-- Body -->
            <div class="card-body">
                <!-- Order Info -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h4 class="fw-semibold text-bg-primary mb-3 p-1">Order Information</h4>
                        <ul class="list-unstyled small">
                            <li><strong>Order Date:</strong> @order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</li>
                            <li>
                                <strong>Status:</strong>
                                @if (order.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                }
                                else if (order.Status == "On Process")
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-truck me-1"></i>On Process</span>
                                }
                                else if (order.Status == "Delivered")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Delivered</span>
                                }
                                else if (order.Status == "Canceled")
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle-fill me-1"></i>Canceled</span>
                                }
                            </li>
                            <li>
                                <strong>Payment Method:</strong>
                                @{
                                    string pm = order.PaymentMethod;
                                    string badgeClass = "badge rounded-pill px-3 py-2 fw-semibold shadow-sm border";
                                    string iconClass = "";
                                    string text = "";

                                    switch (pm)
                                    {
                                        case "CashOnDelivery":
                                            badgeClass += " bg-light text-dark border-secondary";
                                            iconClass = "bi bi-cash-stack me-1 text-success";
                                            text = "Cash on Delivery";
                                            break;
                                        case "Bkash":
                                            badgeClass += " bg-danger text-white";
                                            iconClass = "bi bi-phone-fill me-1";
                                            text = "bKash";
                                            break;
                                        case "Nagad":
                                            badgeClass += " bg-warning text-dark";
                                            iconClass = "bi bi-wallet2 me-1";
                                            text = "Nagad";
                                            break;
                                        case "Rocket":
                                            badgeClass += " bg-info text-dark";
                                            iconClass = "bi bi-send-fill me-1";
                                            text = "Rocket";
                                            break;
                                        default:
                                            badgeClass += " bg-primary text-white";
                                            iconClass = "bi bi-credit-card-2-front me-1";
                                            text = "Card";
                                            break;
                                    }
                                }
                                <span class="@badgeClass"><i class="@iconClass"></i>@text</span>
                            </li>
                        </ul>
                    </div>

                    <div class="col-md-6">
                        <h4 class="fw-semibold text-bg-primary mb-3 p-1">Delivery Information</h4>
                        <ul class="list-unstyled small">
                            <li><strong>Name:</strong> @order.Name</li>
                            <li><strong>Phone:</strong> @order.Phone</li>
                            <li><strong>City:</strong> @order.City</li>
                            <li><strong>Area:</strong> @order.Area</li>
                            <li><strong>Address:</strong> @order.Address</li>
                        </ul>
                    </div>
                </div>

                <hr class="mb-4" />

                <!-- Ordered Products Table -->
                <h4 class="fw-semibold text-bg-primary mb-3 p-1">Ordered Products</h4>
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="example">
                        <thead class="table-light">
                            <tr>
                                <th>Image</th>
                                <th>Product</th>
                                <th class="text-center">Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if(products!= null && products.Any())
                            {
                                @foreach (var item in products)
                                {
                                    <tr>
                                        <td style="width: 80px;">
                                            <img src="@item.Product.Image" class="img-fluid rounded shadow-sm" alt="@item.Product.Name" />
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@item.Product.Name</span><br />
                                            <small class="text-muted">@item.Product.Author?.Name</small>
                                        </td>
                                        <td class="text-center">৳@(item.Product.Price - (item.Product.Discount??0))</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end fw-semibold text-success">৳@((item.Product.Price - (item.Product.Discount ?? 0)) * item.Quantity)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Summary -->
                <div class="row justify-content-end mt-4">
                    <div class="col-md-5">
                        <div class="border rounded-3 p-3 bg-light shadow-sm">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal</span>
                                <span>৳@order.TotalAmount</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Delivery Charge</span>
                                <span>৳@order.DeliveryCharge</span>
                            </div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between fw-bold text-success">
                                <span>Total</span>
                                <span>৳@(order.TotalAmount + order.DeliveryCharge)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Buttons -->
                <div class="mt-4 d-flex justify-content-between">
                    <a asp-action="OrderList" asp-controller="Order" class="btn btn-outline-dark px-4">
                        <i class="bi bi-arrow-left-circle me-2"></i> Back to Orders
                    </a>

                    @* <a asp-action="Invoice" asp-route-id="@order.ID" class="btn btn-outline-success px-4">
                        <i class="bi bi-file-earmark-arrow-down-fill me-2"></i> Download Invoice
                    </a> *@
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container my-5 text-center">
        <div class="alert alert-danger shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Order not found. Please try again later.
        </div>
        <a asp-action="OrderList" asp-controller="Order" class="btn btn-outline-secondary mt-3">
            <i class="bi bi-arrow-left-circle me-1"></i> Back to Orders
        </a>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
