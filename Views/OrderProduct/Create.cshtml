@model EBookStore.Models.OrderProduct

@{
    ViewData["Title"] = "Create OrderProduct";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4">
        <!-- Card header -->
        <div class="card-header text-white rounded-top-4" style="background: linear-gradient(90deg, #0d6efd, #6610f2);">
            <h4 class="mb-0"><i class="bi bi-basket3-fill me-2"></i> Create OrderProduct</h4>
        </div>

        <!-- Card body -->
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Order selection -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Order</label>
                    <select asp-for="OrderID" class="form-control rounded shadow-sm" asp-items="ViewBag.OrderID">
                        <option value="">--Select Order--</option>
                    </select>
                </div>

                <!-- Product selection -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Product</label>
                    <select asp-for="ProductID" class="form-control rounded shadow-sm" asp-items="ViewBag.ProductID">
                        <option value="">--Select Product--</option>
                    </select>
                </div>

                <!-- Quantity -->
                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label fw-semibold"></label>
                    <input asp-for="Quantity" class="form-control rounded shadow-sm" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label asp-for="Price" class="form-label fw-semibold"></label>
                    <input asp-for="Price" class="form-control rounded shadow-sm" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <!-- Action buttons -->
                <div class="d-flex gap-3 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left-circle me-1"></i> Back
                    </a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-save2-fill me-1"></i> Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @@await Html.RenderPartialAsync("_ValidationScriptsPartial")
}
