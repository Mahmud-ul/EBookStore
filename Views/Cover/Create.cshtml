@model EBookStore.Models.Cover

@{
    ViewData["Title"] = "Create Cover";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4 p-3">
        <!-- Header -->
        <div class="card-header bg-gradient-primary text-white rounded-top mb-4">
            <h5 class="mb-0"><i class="fa fa-book-open me-2"></i> Create Cover</h5>
        </div>

        <!-- Body -->
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control shadow-sm rounded" placeholder="Enter cover name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Status -->
                <div class="form-check mb-4">
                    <input class="form-check-input" asp-for="Status" />
                    <label class="form-check-label fw-semibold" asp-for="Status"></label>
                </div>

                <!-- Buttons -->
                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fa fa-save me-1"></i> Create
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fa fa-arrow-left me-1"></i> Back
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .card {
        border: none;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .card-header {
        background: linear-gradient(90deg, #007bff, #6610f2);
        color: white;
        font-weight: 600;
    }

    .form-control {
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, .25);
        }

    .btn {
        border-radius: 8px;
        font-weight: 500;
    }
</style>
